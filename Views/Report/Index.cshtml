@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">
    <h1><i class="fas fa-chart-bar"></i> Reports Dashboard</h1>
    <p class="text-muted">Export your data to Excel format</p>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-boxes"></i> Products Report</h4>
                </div>
                <div class="card-body">
                    <p>Export all products with their storage fees and status.</p>
                    <a asp-action="ProductsReport" class="btn btn-primary">
                        <i class="fas fa-file-excel"></i> Export Products to Excel
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-white">
                    <h4 class="mb-0"><i class="fas fa-calendar-alt"></i> Schedules Report</h4>
                </div>
                <div class="card-body">
                    <p>Export all schedule requests with their status.</p>
                    <a asp-action="SchedulesReport" class="btn btn-warning">
                        <i class="fas fa-file-excel"></i> Export Schedules to Excel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}