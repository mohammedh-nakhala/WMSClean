@model WMSClean.Models.Warehouse

@{
    ViewData["Title"] = "Edit Warehouse";
}

<h1>Edit Warehouse</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="MaxItems"></label>
        <input asp-for="MaxItems" class="form-control" type="number" required />
    </div>

    <div class="form-group">
        <label asp-for="MaxWeightKg"></label>
        <input asp-for="MaxWeightKg" class="form-control" type="number" step="0.1" required />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>