@model IEnumerable<WMSClean.Models.Payment>

@{
    ViewData["Title"] = "My Payments";
}

<div class="container mt-4">
    <h1>My Payment History</h1>

    <table class="table table-striped">
        <thead>
            <tr><th>Date</th><th>Product</th><th>Amount</th><th>Status</th><th>Receipt</th></tr>
        </thead>
        <tbody>
            @foreach (var payment in Model)
            {
                <tr>
                    <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                        <td>@payment.Product?.Name</td>
                        <td>@payment.Amount.ToString("C")</td>
                        <td><span class="badge bg-success">@payment.Status</span></td>
                        <td><a asp-action="Receipt" asp-route-id="@payment.Id" class="btn btn-sm btn-info">View</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>