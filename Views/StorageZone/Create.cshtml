@model WMSClean.Models.StorageZone

@{
    ViewData["Title"] = "Add Storage Zone";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fas fa-plus-circle"></i> Add Storage Zone</h3>
                </div>
                <div class="card-body">
                    @if (ViewBag.Warehouses == null || !((IEnumerable<WMSClean.Models.Warehouse>)ViewBag.Warehouses).Any())
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            No warehouses found! Please <a href="/Warehouse/Create">create a warehouse</a> first.
                        </div>
                    }
                    else
                    {
                        <form asp-action="Create" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="mb-3">
                                <label asp-for="ZoneName" class="form-label fw-bold">Zone Name</label>
                                <input asp-for="ZoneName" class="form-control" placeholder="e.g., Zone A, Cold Storage" required />
                                <span asp-validation-for="ZoneName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ZoneType" class="form-label fw-bold">Zone Type</label>
                                <select asp-for="ZoneType" class="form-select" required>
                                    <option value="General">📦 General</option>
                                    <option value="Cold">❄️ Cold Storage</option>
                                    <option value="Hazardous">⚠️ Hazardous</option>
                                    <option value="Fragile">🥚 Fragile</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="WarehouseId" class="form-label fw-bold">Warehouse</label>
                                <select asp-for="WarehouseId" class="form-select" required>
                                    <option value="">-- Select Warehouse --</option>
                                    @foreach (var wh in ViewBag.Warehouses)
                                    {
                                        <option value="@wh.Id">@wh.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="WarehouseId" class="text-danger"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="AreaSqm" class="form-label fw-bold">Area (m²)</label>
                                        <input asp-for="AreaSqm" class="form-control" type="number" step="1" required />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="MaxCapacityPercent" class="form-label fw-bold">Max Capacity (%)</label>
                                        <input asp-for="MaxCapacityPercent" class="form-control" type="number" value="100" required />
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PricePerCubicMeterPerDay" class="form-label fw-bold">Price (per m³/day)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="PricePerCubicMeterPerDay" class="form-control" type="number" step="0.5" value="5" required />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="DefaultHeightMeters" class="form-label fw-bold">Height (m)</label>
                                        <input asp-for="DefaultHeightMeters" class="form-control" type="number" step="0.1" value="2.5" required />
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Create Zone
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Back to List
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}